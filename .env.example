# ---------------------------------------------------------------------------
# SEVELIAN pre-order page configuration
# Copy to `.env.production` (or set these in your host's dashboard).
# Anything left empty is treated as "not configured".
# ---------------------------------------------------------------------------

# Public URL of this page, with trailing slash. Used for canonical + Open Graph.
VITE_SITE_URL=https://sevelian.com/pre-order/

# Sub-path the build is served from. "/" for a subdomain, "/pre-order/" for sevelian.com/pre-order
VITE_BASE_PATH=/pre-order/

# Launch moment in ISO-8601 with timezone offset. Empty -> "COMING SOON" (no fake countdown).
# Example: VITE_LAUNCH_DATE=2027-03-01T10:00:00+05:30
VITE_LAUNCH_DATE=

# Endpoint that receives registrations (POST JSON). Must return 2xx on success,
# 409 for an already-registered email, 400/422 with { errors } for invalid input.
# Empty -> the form shows "Registrations are not open yet" and never fakes success.
VITE_EARLY_ACCESS_API_URL=

# Official Instagram. Leave empty until confirmed; social links stay hidden until set.
VITE_INSTAGRAM_HANDLE=
VITE_INSTAGRAM_URL=

# Main store + legal pages
VITE_MAIN_SITE_URL=https://sevelian.com/
VITE_CONTACT_URL=https://sevelian.com/contact
VITE_PRIVACY_URL=
VITE_TERMS_URL=

# --- Reference API server only (server/index.mjs) ---
API_PORT=8787
# Comma-separated origins allowed to POST (production page origin)
API_ALLOWED_ORIGINS=http://localhost:5173
